mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
mainFrame.BorderSizePixel = 0
mainFrame.ClipsDescendants = true
mainFrame.BackgroundTransparency = 1 -- للأنيميشن

-- الحواف الملونة (Rainbow Animation)
local strokeMain = Instance.new("UIStroke", mainFrame)
strokeMain.Thickness = 3
strokeMain.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
strokeMain.Transparency = 1

task.spawn(function()
    local hue = 0
    while true do
        hue = hue + (1/300)
        if hue > 1 then hue = 0 end
        strokeMain.Color = Color3.fromHSV(hue, 1, 1)
        task.wait()
    end
end)

local cornerMain = Instance.new("UICorner", mainFrame)
