-- زر التشغيل
local startBtn = Instance.new("TextButton", mainFrame)
startBtn.Size = UDim2.new(0.85, 0, 0.35, 0)
startBtn.Position = UDim2.new(0.075, 0, 0.45, 0)
startBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
startBtn.Text = "Stealing the enemy's flag"
startBtn.TextColor3 = Color3.new(1, 1, 1)
startBtn.TextSize = 16
startBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", startBtn).CornerRadius = UDim.new(0, 10)

-- [[ كود المهمة الخاص بك (بدون تغيير أي حرف) ]]
startBtn.MouseButton1Click:Connect(function()
    -- تأثير الضغط
    tweenService:Create(startBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 0, 0)}):Play()
    task.wait(0.2)
    tweenService:Create(startBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()

    -- تشغيل الكود الأصلي
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    
    local walkSpeed = 30
    local waitAtSpawn = 15 
    local nearLadderDistance = 3 

    local function showNotice(seconds)
        local screenGui = Instance.new("ScreenGui", playerGui)
        local frame = Instance.new("Frame", screenGui)
        frame.Size = UDim2.new(0.4, 0, 0.2, 0)
        frame.Position = UDim2.new(0.3, 0, 0.1, 0)
        frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        frame.BackgroundTransparency = 0.3
        frame.BorderSizePixel = 0
        Instance.new("UICorner", frame)
        local textLabel = Instance.new("TextLabel", frame)
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.new(1, 1, 1)
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.GothamBold
        for i = seconds, 1, -1 do
            textLabel.Text = "🛡️ يرجى الانتظار " .. i .. " ثانية للحصول على أفضل نتيجة\n Please wait " .. i .. " seconds for the best result.\n 🚀 السكربت قيد المعالجة الآن..."
            task.wait(1)
        end
        screenGui:Destroy()
    end

    local myTeamName = player.Team and player.Team.Name or ""
    local myTeam = (string.sub(myTeamName:lower(), 1, 1) == "r") and "Red" or "Blue"
    local enemyTeam = (myTeam == "Red") and "Blue" or "Red"

    local function walkTo(targetCFrame, speed)
        local distance = (root.Position - targetCFrame.Position).Magnitude
        local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        local tween = tweenService:Create(root, info, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end

    local function findLadderIn(teamName)
        local base = workspace.Map:FindFirstChild(teamName)
        if base and base:FindFirstChild("Hole") then
            return base.Hole:FindFirstChild("Smooth Block Model", true)
        end
        return nil
    end

    local spawnPos = Vector3.new(3.295, -24.45, 1.251)

    local myLadderStart = findLadderIn(myTeam)
    if myLadderStart then
        root.CFrame = myLadderStart:GetPivot() * CFrame.new(0, 0, nearLadderDistance)
        task.wait(0.5)
    end

    local enemyLadder = findLadderIn(enemyTeam)
    local enemyFlag = workspace.Map[enemyTeam].Flag:FindFirstChild("Handle", true)

    if enemyLadder and enemyFlag then
        root.CFrame = enemyLadder:GetPivot() * CFrame.new(0, 0, 5) 
        task.wait(2)
        root.CFrame = enemyLadder:GetPivot() * CFrame.new(0, 7, 0)
        task.wait(0.5)
        walkTo(enemyFlag.CFrame * CFrame.new(0, 2, 0), walkSpeed)
        task.wait(1.5) 

        local myLadder = findLadderIn(myTeam)
        local myFlag = workspace.Map[myTeam].Flag:FindFirstChild("Handle", true)
        
        if myLadder and myFlag then
            root.CFrame = enemyLadder:GetPivot() * CFrame.new(0, 0, 5)
            task.wait(0.5)
            root.CFrame = CFrame.new(spawnPos)
            showNotice(waitAtSpawn)
            local nearLadderPoint = myLadder:GetPivot() * CFrame.new(0, 0, nearLadderDistance)
            walkTo(nearLadderPoint, walkSpeed)
            local flagTarget = myFlag.CFrame * CFrame.new(0, 2, 0)
            walkTo(flagTarget, walkSpeed)
        end
    end
end)

-- كود السحب (Dragging)
local dragging, dragInput, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true dragStart = input.Position startPos = mainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
userInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- أنيميشن الظهور Fade-in
tweenService:Create(mainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
tweenService:Create(strokeMain, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Transparency = 0}):Play()
