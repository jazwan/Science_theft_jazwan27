-- [2] واجهة العداد التنازلي (تم وضع تأثير الأبيض والأسود مع الحفاظ على النص)
local timerGui, timerFrame, timerLabel, timerConn = createGradientGui("TimerGui", UDim2.new(0, 450, 0, 60), UDim2.new(0.5, 0, 0.4, 0))
timerFrame.Visible = false

local function showTimer(seconds)
    timerFrame.Visible = true
    for i = seconds, 1, -1 do
        timerLabel.Text = "Please wait for <font color='#FFD700'>" .. i .. "</font> seconds to get the best result"
        task.wait(1)
    end
    timerFrame.Visible = false
end

-- [3] البحث عن الماب والمواقع والأدراج والأعلام (نفس الكود الأصلي)
local map = workspace:FindFirstChild("Map")
local spawnLocation = workspace:FindFirstChild("SpawnLocation")

if not map then warn("لم يتم العثور على الماب!") return end
if not spawnLocation then warn("لم يتم العثور على SpawnLocation!") return end

local redFolder = map:FindFirstChild("Red")
local blueFolder = map:FindFirstChild("Blue")

local redLadder = redFolder and redFolder:FindFirstChild("Hole") and redFolder.Hole:FindFirstChild("Ladder")
local blueLadder = blueFolder and blueFolder:FindFirstChild("Hole") and blueFolder.Hole:FindFirstChild("Ladder")

if not (redLadder and blueLadder) then warn("هناك نقص في أجزاء السلالم!") return end

local isRedTeam = true
if player.Team then
	if string.match(string.lower(player.Team.Name), "red") then
		isRedTeam = true
	elseif string.match(string.lower(player.Team.Name), "blue") then
		isRedTeam = false
	end
else
	local redDist = (rootPart.Position - redLadder:GetPivot().Position).Magnitude
	local blueDist = (rootPart.Position - blueLadder:GetPivot().Position).Magnitude
	isRedTeam = (redDist < blueDist)
end

local myFolder = isRedTeam and redFolder or blueFolder
local enemyFolder = isRedTeam and blueFolder or redFolder

local myLadderModel = isRedTeam and redLadder or blueLadder
local enemyLadderModel = isRedTeam and blueLadder or redLadder

local function getFlagPart(folder)
	local flag = folder and folder:FindFirstChild("Flag", true)
	if flag then
		return flag:IsA("BasePart") and flag or flag:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local myFlagPart = getFlagPart(myFolder)
local enemyFlagPart = getFlagPart(enemyFolder)

if not enemyFlagPart then warn("لم يتم العثور على علم الخصم!") return end
if not myFlagPart then warn("لم يتم العثور على علم فريقك!") return end

local function getTopLadderCFrame(ladderModel)
	local topY = -math.huge
	local topPart = nil
	for _, part in ipairs(ladderModel:GetDescendants()) do
		if part:IsA("BasePart") and part.Position.Y > topY then
			topY = part.Position.Y
			topPart = part
		end
	end
	if topPart then return CFrame.new(topPart.Position + Vector3.new(0, 1, 2)) end
	return ladderModel:GetPivot()
end

local myLadderPart = myLadderModel:FindFirstChild("Smooth Block Model") or myLadderModel:FindFirstChildWhichIsA("BasePart")
local enemyLadderPart = enemyLadderModel:FindFirstChild("Smooth Block Model") or enemyLadderModel:FindFirstChildWhichIsA("BasePart")
if not (myLadderPart and enemyLadderPart) then return end

local stepOffset = Vector3.new(0, -1, 2)
local point_SpawnLoc = CFrame.new(spawnLocation.Position + Vector3.new(0, 3, 0))

local point_MyLadderBottom = CFrame.new(myLadderPart.Position + stepOffset)
local point_MyLadderTop = getTopLadderCFrame(myLadderModel)
local point_MyFlag = CFrame.new(myFlagPart.Position)

local point_EnemyLadderBottom = CFrame.new(enemyLadderPart.Position + stepOffset)
local point_EnemyLadderTop = getTopLadderCFrame(enemyLadderModel)
local point_EnemyFlag = CFrame.new(enemyFlagPart.Position)

local speed = 25

local noclipConnection
local function startNoclip()
	if not noclipConnection then
		noclipConnection = RunService.Stepped:Connect(function()
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end)
	end
end

local function stopNoclip()
	if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
end

local function flyTo(targetCFrame)
	local distance = (rootPart.Position - targetCFrame.Position).Magnitude
	local timeToTake = distance / speed
	
	local tweenInfo = TweenInfo.new(timeToTake, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	tween.Completed:Wait()
end

task.spawn(function()
	rootPart.Anchored = false 
	humanoid.PlatformStand = true
	
	local antiGravity = Instance.new("BodyVelocity")
	antiGravity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	antiGravity.Velocity = Vector3.new(0, 0, 0)
	antiGravity.Parent = rootPart
	
	startNoclip()
	
	flyTo(point_MyLadderBottom)
	flyTo(point_SpawnLoc)
	
	showTimer(5)
	
	flyTo(point_EnemyLadderBottom)
	task.wait(1)
	
	flyTo(point_EnemyLadderTop)
	task.wait(1)
	
	flyTo(point_EnemyFlag)
	
	antiGravity.Parent = nil
	humanoid.PlatformStand = false
	stopNoclip()
	
	task.wait(2)
	
	rootPart.Anchored = false
	humanoid.PlatformStand = true
	antiGravity.Parent = rootPart
	startNoclip()
	
	flyTo(point_SpawnLoc)
	
	showTimer(10)
	
	flyTo(point_MyLadderBottom)
	task.wait(1)
	
	flyTo(point_MyLadderTop)
	task.wait(1)
	
	flyTo(point_MyFlag)
	
	stopNoclip()
	antiGravity:Destroy()
	humanoid.PlatformStand = false
	
	print("Subscribe to the developer's channel TikTok: jazwan27!")
end)
